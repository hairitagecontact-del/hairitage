# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── Apple Wallet ───────────────────────────────────────────
# Après création du compte Apple Developer :
# 1. Crée un "Pass Type ID" dans le portail Apple Developer
# 2. Génère un certificat .p12 et exporte-le en base64
APPLE_TEAM_ID=XXXXXXXXXX
APPLE_PASS_TYPE_ID=pass.ma.hairitage.loyalty
APPLE_CERT_P12_BASE64=MIIKxA...   # contenu du fichier .p12 en base64
APPLE_CERT_PASSWORD=ton_mot_de_passe_p12
# WWDR certificate (Apple Worldwide Developer Relations)
# Télécharge sur : https://www.apple.com/certificateauthority/
APPLE_WWDR_CERT_BASE64=MIIEv...

# ── Google Wallet ──────────────────────────────────────────
# Après activation de l'API Google Wallet dans Google Cloud :
# 1. Crée un compte de service et télécharge le fichier JSON
# 2. Colle le contenu ici (sur une seule ligne, JSON stringifié)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
GOOGLE_WALLET_ISSUER_ID=3388000000XXXXXXXXX   # dans Google Pay & Wallet Console

# ── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=https://hairitage.vercel.app
# PIN code pour accéder à l'interface caisse (4 chiffres)
CAISSE_PIN=1234
